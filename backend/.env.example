DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=erp_attendance
DB_CONNECTION_LIMIT=10

# Security and CORS
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://attendence-erp.vercel.app

PORT=5000
NODE_ENV=development

# SMTP Email Config (Optional, falls back to console.log in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AttendERP" <noreply@erpattendance.com>
SMTP_SECURE=false
